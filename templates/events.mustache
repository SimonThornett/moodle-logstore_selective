{{!
    @template logstore_selective/events

    Template for the events settings page.

    Example context (json):
    {

    }
}}
<div class="logstore-selective container-fluid">
  <div class="logstore-selective header row ">
    <h2>{{#str}}events:heading, logstore_selective{{/str}}</h2>
    <p>
      {{#str}}events:description, logstore_selective{{/str}}
    </p>
  </div>
  <div class="logstore-selective table row">
    {{{table}}}
  </div>
  <div class="logstore-selective footer-bar row">
    <span class="changes p-5 offset-3 col-3 text-end align-middle">
      Changes:
      <span id="logstore-selective-setting-changes" data-value="0">0</span>
    </span>
    <span class="submit-button p-4 col-3 text-start align-middle">
      <button class="btn btn-primary" id="logstore-selective-submit">Save settings</button>
    </span>
  </div>
</div>